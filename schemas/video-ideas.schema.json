{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/video-ideas.schema.json",
  "title": "Short Video Ideas Bundle",
  "type": "object",
  "required": ["version", "persona", "research", "videos"],
  "properties": {
    "version": { "type": "string" },
    "generated_at": { "type": "string" },
    "persona": {
      "type": "object",
      "required": ["industry", "region"],
      "properties": {
        "name": { "type": "string" },
        "industry": { "type": "string" },
        "region": { "type": "string" },
        "audience": { "type": "string" }
      },
      "additionalProperties": true
    },
    "research": {
      "type": "object",
      "required": ["summary", "queries", "sources"],
      "properties": {
        "summary": { "type": "string" },
        "queries": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url", "why_it_matters"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string" },
              "published_at": { "type": "string" },
              "publisher": { "type": "string" },
              "why_it_matters": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "title", "format", "angle", "arc", "timeline", "production"],
        "properties": {
          "id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["candidate", "selected", "removed", "expanded", "draft", "approved"]
          },
          "title": { "type": "string" },
          "industry": { "type": "string" },
          "region": { "type": "string" },
          "format": { "type": "string" },
          "angle": { "type": "string" },
          "hook_options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["angle", "verbal", "visual", "on_screen_text"],
              "properties": {
                "angle": { "type": "string" },
                "verbal": { "type": "string" },
                "visual": { "type": "string" },
                "on_screen_text": { "type": "string" },
                "rationale": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "why_now": { "type": "string" },
          "target_viewer": { "type": "string" },
          "arc": {
            "type": "object",
            "required": ["hook", "setup", "turn", "payoff", "cta"],
            "properties": {
              "hook": { "type": "string" },
              "setup": { "type": "string" },
              "turn": { "type": "string" },
              "payoff": { "type": "string" },
              "cta": { "type": "string" }
            },
            "additionalProperties": true
          },
          "timeline": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["start", "end", "purpose", "voiceover", "visual", "on_screen_text", "asset_needs"],
              "properties": {
                "start": { "type": "number" },
                "end": { "type": "number" },
                "purpose": { "type": "string" },
                "voiceover": { "type": "string" },
                "visual": { "type": "string" },
                "on_screen_text": { "type": "string" },
                "asset_needs": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": true
            }
          },
          "production": {
            "type": "object",
            "required": ["aspect_ratio", "duration_seconds", "hyperframes_workflow", "visual_style", "audio"],
            "properties": {
              "aspect_ratio": { "type": "string" },
              "duration_seconds": { "type": "number" },
              "hyperframes_workflow": { "type": "string" },
              "visual_style": { "type": "string" },
              "audio": { "type": "string" },
              "image_search_queries": {
                "type": "array",
                "items": { "type": "string" }
              },
              "notes": { "type": "string" }
            },
            "additionalProperties": true
          },
          "social_copy": {
            "type": "object",
            "properties": {
              "caption": { "type": "string" },
              "hashtags": {
                "type": "array",
                "items": { "type": "string" }
              },
              "pinned_comment": { "type": "string" },
              "cta_note": { "type": "string" }
            },
            "additionalProperties": true
          },
          "claims_to_verify": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
